rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMember(householdId) {
      return request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    match /households/{householdId} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      
      allow get: if request.auth != null && (request.auth.uid in resource.data.memberIds);
      allow list: if false; 
      
      allow update: if request.auth != null && (
        ( // === กรณีที่ 1: สมาชิกเดิมแก้ไขข้อมูล ===
          (request.auth.uid in resource.data.memberIds) &&
          (request.resource.data.adminId == resource.data.adminId) && // ห้ามเปลี่ยนแอดมิน
          (request.resource.data.inviteCode == resource.data.inviteCode) // ห้ามเปลี่ยนรหัสเชิญ
        ) 
        || 
        ( // === กรณีที่ 2: คนนอกกำลังขอเข้าร่วมบ้าน (Join) ===
          !(request.auth.uid in resource.data.memberIds) && // ต้องยังไม่เป็นสมาชิก
          (request.auth.uid in request.resource.data.memberIds) && // กำลังเพิ่มตัวเองเข้าไป
          (request.resource.data.joinCode == resource.data.inviteCode) && // รหัสเข้าร่วมต้องตรง
          // ต้องอัปเดตเฉพาะ 3 ฟิลด์นี้เท่านั้น ห้ามแตะฟิลด์อื่น
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'members', 'joinCode'])) &&
          // ห้ามลบสมาชิกเดิม และต้องเพิ่มแค่ 1 คน (ตัวเอง) เท่านั้น
          (request.resource.data.memberIds.hasAll(resource.data.memberIds)) &&
          (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1)
        )
      );
      allow delete: if false;

      match /patients/{patientId} {
        allow read, write: if request.auth != null && isMember(householdId);
      }
      match /doseRecords/{recordId} {
        allow read, write: if request.auth != null && isMember(householdId);
      }
      match /activities/{activityId} {
        allow read, write: if request.auth != null && isMember(householdId);
      }
    }

    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null;
    }

    match /patients/{patientId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.ownerId == request.auth.uid) ||
        (resource != null && resource.data.ownerId == request.auth.uid)
      );
    }
  }
}
